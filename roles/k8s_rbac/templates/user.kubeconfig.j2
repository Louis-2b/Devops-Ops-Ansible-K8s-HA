apiVersion: v1
kind: Config
clusters:
  - name: {{ k8s_rbac_cluster_name }}
    cluster:
      certificate-authority-data: {{ k8s_rbac_ca.content }}
      server: {{ k8s_rbac_api_server }}
users:
  - name: {{ k8s_rbac_user_id }}
    user:
      client-certificate-data: {{ k8s_rbac_cert_data }}
      client-key-data: {{ k8s_rbac_key_data }}
contexts:
  - name: {{ k8s_rbac_user_id }}@{{ k8s_rbac_cluster_name }}
    context:
      cluster: {{ k8s_rbac_cluster_name }}
      user: {{ k8s_rbac_user_id }}
current-context: {{ k8s_rbac_user_id }}@{{ k8s_rbac_cluster_name }}
preferences: {}
