apiVersion: v1
kind: Config
clusters:
  - name: {{ k8s_rbac_cluster_name }}
    cluster:
      certificate-authority-data: {{ k8s_rbac_ca.content }}
      server: {{ k8s_rbac_api_server }}
users:
  - name: {{ k8s_rbac_sa.name }}
    user:
      token: {{ k8s_rbac_sa_token }}
contexts:
  - name: {{ k8s_rbac_sa.name }}@{{ k8s_rbac_cluster_name }}
    context:
      cluster: {{ k8s_rbac_cluster_name }}
      user: {{ k8s_rbac_sa.name }}
current-context: {{ k8s_rbac_sa.name }}@{{ k8s_rbac_cluster_name }}
preferences: {}
