# {{ ansible_managed }}
global_defs {
    router_id {{ inventory_hostname }}
    enable_script_security
    script_user root
}

# Retire la VIP à ce nœud si HAProxy n'est plus en cours d'exécution.
vrrp_script chk_haproxy {
    script "/usr/bin/pgrep -x haproxy"
    interval 2
    fall 2
    rise 2
}

vrrp_instance KUBERNETES_API {
    state BACKUP
    interface {{ ha_vip_interface }}
    virtual_router_id {{ ha_virtual_router_id }}
    priority {{ ha_priority }}
    advert_int 1
    # VRRP en unicast : fonctionne sur les réseaux virtuels qui filtrent le multicast.
    unicast_src_ip {{ ha_node_ip }}
    unicast_peer {
{% for peer in groups[ha_peers_group] | sort if peer != inventory_hostname %}
        {{ hostvars[peer].kubernetes_node_ip | default(hostvars[peer].ansible_host | default(peer)) }}
{% endfor %}
    }
{% if ha_auth_pass | length > 0 %}
    authentication {
        auth_type PASS
        auth_pass {{ ha_auth_pass }}
    }
{% endif %}
    virtual_ipaddress {
        {{ ha_vip_address }}/{{ ha_vip_prefix }} dev {{ ha_vip_interface }}
    }
    track_script {
        chk_haproxy
    }
}
