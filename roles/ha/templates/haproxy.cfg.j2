# {{ ansible_managed }}
global
    log /dev/log local0
    maxconn {{ ha_maxconn }}
    user haproxy
    group haproxy

defaults
    log global
    mode tcp
    option tcplog
    option dontlognull
    retries 3
    timeout connect {{ ha_timeout_connect }}
    timeout client  {{ ha_timeout_client }}
    timeout server  {{ ha_timeout_server }}

frontend kubernetes-api
    bind {{ ha_vip_address }}:{{ ha_bind_port }}
    default_backend kubernetes-control-planes

backend kubernetes-control-planes
    balance {{ ha_balance }}
    # Sonde HTTPS sur /livez de kube-apiserver (lisible sans authentification)
    option httpchk GET /livez
    http-check expect status 200
    default-server inter {{ ha_check_interval }} fall {{ ha_check_fall }} rise {{ ha_check_rise }}
{% for host in groups[ha_backend_group] | sort %}
    server {{ host }} {{ hostvars[host].kubernetes_node_ip | default(hostvars[host].ansible_host | default(host)) }}:{{ ha_backend_port }} check check-ssl verify none
{% endfor %}
