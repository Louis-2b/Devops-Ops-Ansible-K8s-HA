# {{ ansible_managed }}
apiVersion: kubeadm.k8s.io/v1beta4
kind: JoinConfiguration
discovery:
  bootstrapToken:
    apiServerEndpoint: "{{ kubernetes_api_endpoint }}"
    token: "{{ worker_join_command.stdout | regex_search('--token (\\S+)', '\\1') | first }}"
    caCertHashes:
      - "{{ worker_join_command.stdout | regex_search('--discovery-token-ca-cert-hash (\\S+)', '\\1') | first }}"
nodeRegistration:
  name: {{ inventory_hostname }}
  criSocket: {{ container_runtime_socket }}
  kubeletExtraArgs:
    - name: node-ip
      value: "{{ worker_node_ip }}"
