# {{ ansible_managed }}
# Configuration minimale (containerd 2.x, format version 3) : les autres paramètres gardent
# leurs valeurs par défaut. Le paquet Docker livre un fichier qui désactive le plugin CRI.
version = 3

[plugins.'io.containerd.cri.v1.runtime'.containerd.runtimes.runc]
  runtime_type = 'io.containerd.runc.v2'

  [plugins.'io.containerd.cri.v1.runtime'.containerd.runtimes.runc.options]
    SystemdCgroup = true
{% if container_runtime_sandbox_image | length > 0 %}

[plugins.'io.containerd.cri.v1.images'.pinned_images]
  sandbox = '{{ container_runtime_sandbox_image }}'
{% endif %}
