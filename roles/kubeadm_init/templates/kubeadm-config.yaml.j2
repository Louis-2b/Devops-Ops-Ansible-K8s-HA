# {{ ansible_managed }}
apiVersion: kubeadm.k8s.io/v1beta4
kind: InitConfiguration
localAPIEndpoint:
  advertiseAddress: {{ ansible_host }}
  bindPort: {{ k8s_control_plane_port }}
nodeRegistration:
  name: {{ inventory_hostname }}
  criSocket: {{ kubeadm_init_cri_socket }}
  kubeletExtraArgs:
    - name: node-ip
      value: "{{ ansible_host }}"
---
apiVersion: kubeadm.k8s.io/v1beta4
kind: ClusterConfiguration
clusterName: {{ k8s_cluster_name }}
kubernetesVersion: v{{ k8s_version }}
controlPlaneEndpoint: "{{ k8s_control_plane_endpoint }}"
networking:
  podSubnet: {{ k8s_pod_cidr }}
  serviceSubnet: {{ k8s_service_cidr }}
  dnsDomain: cluster.local
apiServer:
  certSANs:
    - {{ k8s_control_plane_vip }}
    - {{ k8s_api_hostname }}
{% for host in groups['control_plane'] %}
    - {{ host }}
    - {{ hostvars[host].ansible_host }}
{% endfor %}
{% if k8s_apiserver_enable_aggregator_routing | bool %}
  extraArgs:
    - name: enable-aggregator-routing
      value: "true"
{% endif %}
{% if k8s_expose_control_plane_metrics | bool %}
controllerManager:
  extraArgs:
    - name: bind-address
      value: 0.0.0.0
scheduler:
  extraArgs:
    - name: bind-address
      value: 0.0.0.0
etcd:
  local:
    extraArgs:
      - name: listen-metrics-urls
        value: http://0.0.0.0:2381
{% endif %}
---
apiVersion: kubelet.config.k8s.io/v1beta1
kind: KubeletConfiguration
cgroupDriver: systemd
{% if k8s_kubelet_serving_cert_bootstrap | bool %}
serverTLSBootstrap: true
{% endif %}
---
apiVersion: kubeproxy.config.k8s.io/v1alpha1
kind: KubeProxyConfiguration
mode: {{ k8s_kube_proxy_mode }}
{% if k8s_expose_control_plane_metrics | bool %}
metricsBindAddress: 0.0.0.0:10249
{% endif %}
{% if k8s_kube_proxy_mode == 'ipvs' %}
ipvs:
  strictARP: true
{% endif %}
