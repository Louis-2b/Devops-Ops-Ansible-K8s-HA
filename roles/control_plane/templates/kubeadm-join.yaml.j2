# {{ ansible_managed }}
apiVersion: kubeadm.k8s.io/v1beta4
kind: JoinConfiguration
discovery:
  bootstrapToken:
    apiServerEndpoint: "{{ kubernetes_api_endpoint }}"
    token: "{{ control_plane_join_command.stdout | regex_search('--token (\\S+)', '\\1') | first }}"
    caCertHashes:
      - "{{ control_plane_join_command.stdout | regex_search('--discovery-token-ca-cert-hash (\\S+)', '\\1') | first }}"
nodeRegistration:
  name: {{ inventory_hostname }}
  criSocket: {{ container_runtime_socket }}
  kubeletExtraArgs:
    - name: node-ip
      value: "{{ control_plane_node_ip }}"
controlPlane:
  localAPIEndpoint:
    advertiseAddress: {{ control_plane_node_ip }}
    bindPort: {{ control_plane_bind_port }}
  certificateKey: "{{ control_plane_certificate_key.stdout }}"
