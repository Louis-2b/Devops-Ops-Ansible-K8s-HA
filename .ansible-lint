---
profile: production
exclude_paths:
  - .github/
  - examples/
  - artifacts/
skip_list:
  # Les noms de tâches contiennent volontairement des variables de boucle (include_tasks).
  - name[template]
  # Les fichiers de tâches secondaires (install.yml, user.yml…) ne préfixent pas leurs noms.
  - name[prefix]
warn_list:
  - experimental
